# ── ReactJatra environment ──────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your keys.
# `.env.local` is git-ignored — never commit real API keys.

# REQUIRED for the AI tutor (server-side only — never exposed to the browser).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL — override the Groq model used by the AI tutor.
# Defaults are tried in order: llama-3.3-70b-versatile → openai/gpt-oss-120b → llama-3.1-8b-instant
# GROQ_MODEL=llama-3.3-70b-versatile
